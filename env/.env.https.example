# 真机连接 Caddy HTTPS 服务器时，复制为 env/.env.development.local。
# 也可将相应变量放到 .env.test.local / .env.production.local。
# 本机后端开发无需复制，继续使用原来的 localhost 配置。
VITE_SERVER_BASEURL=https://api.hsunr.xyz
VITE_SERVER_BASEURL__WEIXIN_DEVELOP=https://api.hsunr.xyz
VITE_SERVER_BASEURL__WEIXIN_TRIAL=https://api.hsunr.xyz
VITE_SERVER_BASEURL__WEIXIN_RELEASE=https://api.hsunr.xyz
